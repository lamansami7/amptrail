# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use the project's publishable key if available. The legacy anon key is also supported.
# This is a browser-safe public key; never put a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Optional alternative to the variable above:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional public support link override (defaults to the official AmpTrail inbox):
# NEXT_PUBLIC_SUPPORT_EMAIL=amptrail.support@gmail.com
# Optional canonical site URL for metadata (defaults to the Vercel production URL):
# NEXT_PUBLIC_SITE_URL=https://getamptrail.vercel.app

# Optional FieldTicket totals comparison (SERVER-ONLY — never prefix these
# with NEXT_PUBLIC_ and never put the API key in browser code):
# FIELDTICKET_COMPARISON_ENABLED=true
# FIELDTICKET_API_KEY=your-fieldticket-api-key
# FIELDTICKET_API_URL=https://fieldticket-api.onrender.com
