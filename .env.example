# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use the project's publishable key if available. The legacy anon key is also supported.
# This is a browser-safe public key; never put a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Optional alternative to the variable above:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional public support link for the Contact page:
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional canonical site URL for metadata:
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
